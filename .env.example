# PostgreSQL (host port 5433 — non-default)
POSTGRES_USER=talentlens
POSTGRES_PASSWORD=talentlens
POSTGRES_DB=talentlens
POSTGRES_PORT=5433

# API
API_PORT=5001
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://talentlens:talentlens@localhost:5433/talentlens
MAX_RESUMES=150
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend (Docker nginx)
FRONTEND_PORT=3000

